#include <stdio.h>

int main(void)
{
    int money = 0, save = 0;
    int plan;
    for (int i = 1; i <= 12; i++)
    {
        money += 300;
        scanf("%d", &plan);
        if (plan > money)
        {
            printf("-%d", i);
            return 0; //可直接终止函数
        }
        else
        {
            money -= plan;
            if (money >= 100)
            {
                int temp = money;
                money %= 100;
                save += (temp - money);
            }
        }
    }
    money = money + save * 1.2;
    printf("%d", money);

    return 0;
}
